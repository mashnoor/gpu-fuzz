# --- Upstream clones (own git repos; fetch separately) ---
/vortex/
/qemu-v8.2.2/
/esp/
/fuzzgpu-artifact/
/guest/linux-*/
/guest/busybox-*/

# Guest rootfs is a build product; keep only hand-written scripts
/guest/rootfs/*
!/guest/rootfs/init
!/guest/rootfs/run-test.sh

